# 账号配置 - 精简格式（推荐）：全局 linux.do 账号 + 站点列表，自动展开
# 站点未配置 linux.do 时自动用全局账号展开，名称自动生成为 provider-1, provider-2, ...
ACCOUNTS={"linux.do":[{"username":"用户名1","password":"密码1"},{"username":"用户名2","password":"密码2"}],"accounts":[{"provider":"anyrouter"},{"provider":"wong"},{"provider":"runawaytime","checkin":true}]}

# 账号配置 - 数组格式（兼容旧版）：每个账号独立配置
# ACCOUNTS=[{"name":"自定义名称","provider":"anyrouter","linux.do":{"username":"你的用户名","password":"你的密码"}},{"name":"账号2","provider":"agentrouter","linux.do":{"username":"你的用户名","password":"你的密码"}}]

# 996 账号配置
ACCOUNTS_996=["账号设置下的系统ACCESS TOKEN"]


# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
